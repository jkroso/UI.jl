function Clay__SizeContainersAlongAxis(xAxis):
    context = GetCurrentContext()
    bfsBuffer = context.layoutElementChildrenBuffer
    resizableContainerBuffer = context.openLayoutElementStack

    for each rootIndex in context.layoutElementTreeRoots:
        bfsBuffer.clear()
        root = GetLayoutElementTreeRoot(rootIndex)
        rootElement = GetLayoutElement(root.layoutElementIndex)
        bfsBuffer.add(root.layoutElementIndex)

        # Size floating containers to their parents
        if ElementHasConfig(rootElement, FLOATING):
            floatingConfig = GetFloatingConfig(rootElement)
            parentItem = GetHashMapItem(floatingConfig.parentId)
            if parentItem exists and is valid:
                parentElement = parentItem.layoutElement
                if rootElement sizing width type is GROW:
                    rootElement.dimensions.width = parentElement.dimensions.width
                if rootElement sizing height type is GROW:
                    rootElement.dimensions.height = parentElement.dimensions.height

        # Clamp root element dimensions to min/max bounds
        ClampDimensions(rootElement)

        # BFS traversal of layout tree
        for each element in bfsBuffer:
            parentIndex = element
            parent = GetLayoutElement(parentIndex)
            parentConfig = parent.layoutConfig
            growContainerCount = 0
            parentSize = xAxis ? parent.width : parent.height
            parentPadding = xAxis ? (parent.padding.left + parent.padding.right) :
                                  (parent.padding.top + parent.padding.bottom)
            innerContentSize = 0
            totalPaddingAndChildGaps = parentPadding
            sizingAlongAxis = (xAxis && layout is LEFT_TO_RIGHT) || (!xAxis && layout is TOP_TO_BOTTOM)
            resizableContainerBuffer.clear()
            parentChildGap = parentConfig.childGap

            # First pass: determine sizes, collect resizable containers
            for each childOffset in parent.children:
                childElement = GetLayoutElement(parent.children[childOffset])
                childSizing = xAxis ? childElement.sizing.width : childElement.sizing.height
                childSize = xAxis ? childElement.width : childElement.height

                # Add non-text elements with children to BFS queue
                if !HasTextConfig(childElement) and childElement has children:
                    bfsBuffer.add(childElementIndex)

                # Collect resizable containers
                if childSizing.type is not PERCENT or FIXED and
                   (!HasTextConfig(childElement) or text wraps words) and
                   (xAxis or not an image element):
                    resizableContainerBuffer.add(childElementIndex)

                # Calculate content size
                if sizingAlongAxis:
                    innerContentSize += (childSizing is PERCENT ? 0 : childSize)
                    if childSizing is GROW:
                        growContainerCount++
                    if not first child:
                        innerContentSize += parentChildGap
                        totalPaddingAndChildGaps += parentChildGap
                else:
                    innerContentSize = max(childSize, innerContentSize)

            # Second pass: expand percentage containers
            for each childOffset in parent.children:
                childElement = GetLayoutElement(parent.children[childOffset])
                childSizing = xAxis ? childElement.sizing.width : childElement.sizing.height

                if childSizing.type is PERCENT:
                    if xAxis:
                        childElement.width = (parentSize - totalPaddingAndChildGaps) * childSizing.percent
                    else:
                        childElement.height = (parentSize - totalPaddingAndChildGaps) * childSizing.percent

                    if sizingAlongAxis:
                        innerContentSize += (xAxis ? childElement.width : childElement.height)
                    UpdateAspectRatioBox(childElement)

            if sizingAlongAxis:
                sizeToDistribute = parentSize - parentPadding - innerContentSize

                # COMPRESSION ALGORITHM
                # This is effectively the Clay__CompressChildrenAlongAxis functionality
                if sizeToDistribute < 0:  # Content too large, compress children
                    # Skip compression if parent clips content in this axis
                    clipConfig = GetClipConfig(parent)
                    if clipConfig exists and ((xAxis and clipConfig.horizontal) or
                                            (!xAxis and clipConfig.vertical)):
                        continue

                    # Iteratively compress largest containers
                    while sizeToDistribute < 0 and resizableContainerBuffer not empty:
                        # Find largest and second largest child
                        largest = 0
                        secondLargest = 0

                        for each childIndex in resizableContainerBuffer:
                            child = GetLayoutElement(childIndex)
                            childSize = xAxis ? child.width : child.height

                            if childSize is same as largest:
                                continue

                            if childSize > largest:
                                secondLargest = largest
                                largest = childSize
                            else if childSize < largest:
                                secondLargest = max(secondLargest, childSize)

                        # Calculate size adjustment
                        widthToAdd = max(secondLargest - largest,
                                        sizeToDistribute / resizableContainerBuffer.length)

                        # Apply size adjustment to all containers with largest size
                        for each childIndex in resizableContainerBuffer:
                            child = GetLayoutElement(childIndex)
                            childSize = xAxis ? child.width : child.height
                            minSize = xAxis ? child.minWidth : child.minHeight

                            if childSize is same as largest:
                                if xAxis:
                                    previousWidth = child.width
                                    child.width += widthToAdd
                                    if child.width <= minSize:
                                        child.width = minSize
                                        remove childIndex from resizableContainerBuffer
                                else:
                                    previousHeight = child.height
                                    child.height += widthToAdd
                                    if child.height <= minSize:
                                        child.height = minSize
                                        remove childIndex from resizableContainerBuffer

                                sizeToDistribute -= (new size - previous size)

                # EXPANSION ALGORITHM
                else if sizeToDistribute > 0 and growContainerCount > 0:  # Content too small, allow growing
                    # Filter to keep only GROW type containers
                    for each childIndex in resizableContainerBuffer:
                        child = GetLayoutElement(childIndex)
                        childSizing = xAxis ? child.sizing.width.type : child.sizing.height.type

                        if childSizing is not GROW:
                            remove childIndex from resizableContainerBuffer

                    # Iteratively expand smallest containers
                    while sizeToDistribute > 0 and resizableContainerBuffer not empty:
                        # Find smallest and second smallest child
                        smallest = MAX_FLOAT
                        secondSmallest = MAX_FLOAT

                        for each childIndex in resizableContainerBuffer:
                            child = GetLayoutElement(childIndex)
                            childSize = xAxis ? child.width : child.height

                            if childSize is same as smallest:
                                continue

                            if childSize < smallest:
                                secondSmallest = smallest
                                smallest = childSize
                            else if childSize > smallest:
                                secondSmallest = min(secondSmallest, childSize)

                        # Calculate size adjustment
                        widthToAdd = min(secondSmallest - smallest,
                                       sizeToDistribute / resizableContainerBuffer.length)

                        # Apply size adjustment to all containers with smallest size
                        for each childIndex in resizableContainerBuffer:
                            child = GetLayoutElement(childIndex)
                            childSize = xAxis ? child.width : child.height
                            maxSize = xAxis ? child.maxWidth : child.maxHeight

                            if childSize is same as smallest:
                                if xAxis:
                                    previousWidth = child.width
                                    child.width += widthToAdd
                                    if child.width >= maxSize:
                                        child.width = maxSize
                                        remove childIndex from resizableContainerBuffer
                                else:
                                    previousHeight = child.height
                                    child.height += widthToAdd
                                    if child.height >= maxSize:
                                        child.height = maxSize
                                        remove childIndex from resizableContainerBuffer

                                sizeToDistribute -= (new size - previous size)
            # Handle off-axis sizing
            else:
                for each childIndex in resizableContainerBuffer:
                    childElement = GetLayoutElement(childIndex)
                    childSizing = xAxis ? childElement.sizing.width : childElement.sizing.height
                    minSize = xAxis ? childElement.minWidth : childElement.minHeight

                    if !xAxis and IsImageElement(childElement):
                        continue  # Skip resizing image height (would break aspect ratio)

                    maxSize = parentSize - parentPadding

                    # For scroll containers, grow to content size, not just visible area
                    if IsClipElement(parent):
                        clipConfig = GetClipConfig(parent)
                        if (xAxis and clipConfig.horizontal) or (!xAxis and clipConfig.vertical):
                            maxSize = max(maxSize, innerContentSize)

                    if childSizing.type is GROW:
                        if xAxis:
                            childElement.width = ClampBetween(
                                min(maxSize, childSizing.maxSize),
                                minSize,
                                maxSize
                            )
                        else:
                            childElement.height = ClampBetween(
                                min(maxSize, childSizing.maxSize),
                                minSize,
                                maxSize
                            )

/**
 * Clay__CalculateFinalLayout
 *
 * Calculates final layout of all elements, handling text wrapping,
 * image scaling, and generating render commands.
 */
function Clay__CalculateFinalLayout():
    context = GetCurrentContext()

    # Step 1: Calculate sizing along X axis
    Clay__SizeContainersAlongAxis(true)

    # Step 2: Wrap text
    for each textElementData in context.textElementData:
        containerElement = GetLayoutElement(textElementData.elementIndex)
        textConfig = GetTextConfig(containerElement)

        # If text fits without wrapping, just add it as a single line
        if text fits without wrapping:
            AddSingleTextLine(textElementData, containerElement.dimensions)
            continue

        # Process text word by word for wrapping
        wordIndex = GetFirstMeasuredWord(textElementData)
        lineWidth = 0
        lineLengthChars = 0
        lineStartOffset = 0

        while wordIndex is valid:
            measuredWord = GetMeasuredWord(wordIndex)

            # Case 1: Single word too wide for line
            if line is empty and word too wide:
                AddTextLine(textElementData, measuredWord as single line)
                lineStartOffset = measuredWord.startOffset + measuredWord.length
                wordIndex = measuredWord.next

            # Case 2: Current word would overflow or is newline
            else if measuredWord is newline or would cause overflow:
                # Add current line
                AddTextLine(textElementData, current line content)

                # Reset or advance for next line
                if line is empty or measuredWord is newline:
                    wordIndex = measuredWord.next

                lineWidth = 0
                lineLengthChars = 0
                lineStartOffset = measuredWord.startOffset

            # Case 3: Word fits on current line
            else:
                lineWidth += measuredWord.width
                lineLengthChars += measuredWord.length
                wordIndex = measuredWord.next

        # Add any remaining text as final line
        if lineLengthChars > 0:
            AddTextLine(textElementData, remaining content)

        # Update container height based on wrapped lines
        containerElement.height = lineHeight * number of wrapped lines

    # Step 3: Scale images to maintain aspect ratio
    for each imageElement in context.imageElements:
        config = GetImageConfig(imageElement)
        imageElement.height = (config.sourceHeight / config.sourceWidth) * imageElement.width

    # Step 4: Propagate height changes up to parents (DFS traversal)
    dfsBuffer = Initialize empty buffer for DFS traversal

    for each root in context.layoutElementTreeRoots:
        rootElement = GetLayoutElement(root.layoutElementIndex)
        Add rootElement to dfsBuffer

    while dfsBuffer not empty:
        currentElement = Top of dfsBuffer

        # Handle first visit (downward traversal)
        if currentElement not visited:
            Mark currentElement as visited

            # Skip text elements and elements without children
            if IsTextElement(currentElement) or currentElement has no children:
                Pop from dfsBuffer
                continue

            # Add children to stack for traversal
            for each child in currentElement.children (in reverse):
                Add child to dfsBuffer

            continue

        # Handle second visit (upward traversal)
        Pop from dfsBuffer
        layoutConfig = currentElement.layoutConfig

        # Update parent dimensions based on children
        if layout is LEFT_TO_RIGHT:
            # Update height based on tallest child
            for each child in currentElement.children:
                childHeightWithPadding = child.height + vertical padding
                currentElement.height = ClampBetween(
                    max(childHeightWithPadding, currentElement.height),
                    currentElement.minHeight,
                    currentElement.maxHeight
                )
        else if layout is TOP_TO_BOTTOM:
            # Sum all child heights plus gaps
            contentHeight = vertical padding

            for each child in currentElement.children:
                contentHeight += child.height

            contentHeight += (number of gaps * childGap)

            currentElement.height = ClampBetween(
                contentHeight,
                currentElement.minHeight,
                currentElement.maxHeight
            )

    # Step 5: Calculate sizing along Y axis
    Clay__SizeContainersAlongAxis(false)

    # Step 6: Sort tree roots by z-index
    SortTreeRootsByZIndex(context.layoutElementTreeRoots)

    # Step 7: Calculate final positions and generate render commands
    context.renderCommands.clear()

    # Process each tree in order
    for each root in context.layoutElementTreeRoots:
        rootElement = GetLayoutElement(root.layoutElementIndex)
        rootPosition = Calculate root position

        # Process clip regions if needed
        if root has clip element:
            Add scissor command to render commands

        # DFS traversal for positioning and render commands
        dfsBuffer.clear()
        Add rootElement to dfsBuffer with rootPosition

        while dfsBuffer not empty:
            currentElement = Top of dfsBuffer

            # Handle first visit (downward traversal)
            if not visited:
                # Calculate bounding box
                # Add render commands for this element
                # Setup child alignment and positioning
                # ...more complex layout logic here...
            else:
                # Handle revisit (upward traversal)
                # Close clip regions if needed
                # Add border render commands if needed

            # ... Rest of rendering position and command generation logic ...
